#!/usr/bin/env ruby
# frozen_string_literal: true

require 'optparse'
require_relative '../lib/certvis'

# The install directory (bundled index.html lives here), vs. the caller's
# cwd (where sites.lst/output default to) -- these differ whenever certvis
# is invoked via a symlink or from $PATH outside the install directory.
install_root = File.expand_path('..', __dir__)
options = {
  sites_file: File.join(Dir.pwd, 'sites.lst'),
  output: File.join(Dir.pwd, 'public', 'certs.json'),
  threads: 2,
  timeout: 10,
  retries: 3,
  backoff: 2,
  verbose: false,
  preserve_html: false,
  deploy_html: true,
  serve: false,
  port: 8000
}

def detect_shell
  ENV['SHELL'].to_s.include?('zsh') ? 'zsh' : 'bash'
end

WEEK = 7 * 24 * 60 * 60
DANGER_START = 4 * WEEK # mirrors public/index.html's own DANGER_START

# Issues worth calling out in -v output: unreachable, wrong host, untrusted
# (self-signed vs. CA-signed-but-not-trusted), expired, or expiring soon.
def site_issues(result, now)
  return ["unreachable: #{result.error}"] unless result.reachable

  issues = []
  issues << 'wrong host' if result.hostname_match == false
  if result.trusted == false
    issues << (result.issuer == result.subject ? 'self-signed' : "untrusted CA (#{result.issuer})")
  end
  if result.not_after
    remaining = result.not_after - now
    if remaining <= 0
      issues << "expired #{result.not_after.strftime('%Y-%m-%d')}"
    elsif remaining <= DANGER_START
      issues << "expires in #{(remaining / 86_400).floor}d (#{result.not_after.strftime('%Y-%m-%d')})"
    end
  end
  issues
end

OptionParser.new do |opts|
  opts.banner = "Usage: certvis [options]\n\n" \
                "Checks TLS certificate expiry for every site in sites.lst and writes\n" \
                "the results to a JSON file for the dashboard in public/index.html.\n\n" \
                "Designed to be run directly or from cron on whatever schedule you like:\n" \
                "  */15 * * * * cd /path/to/certvis && bin/certvis >> certvis.log 2>&1\n\n"

  opts.on('-f', '--sites-file PATH', 'Path to sites list (default: ./sites.lst)') { |v| options[:sites_file] = v }
  opts.on('-o', '--output PATH', 'Path to write JSON output (default: ./public/certs.json)') { |v| options[:output] = v }
  opts.on('-t', '--threads N', Integer, 'Number of checker threads (default: 2)') { |v| options[:threads] = v }
  opts.on('--timeout N', Integer, 'Per-connection timeout in seconds (default: 10)') { |v| options[:timeout] = v }
  opts.on('--retries N', Integer, 'Retry attempts per site on failure (default: 3)') { |v| options[:retries] = v }
  opts.on('--backoff N', Integer, 'Base backoff seconds; doubles each retry (default: 2)') { |v| options[:backoff] = v }
  opts.on('--preserve-html', "Don't overwrite an out-of-date index.html next to --output") { options[:preserve_html] = true }
  opts.on('--no-deploy-html', 'Never copy index.html next to --output') { options[:deploy_html] = false }
  opts.on('--serve', 'Serve the output directory over HTTP after writing') { options[:serve] = true }
  opts.on('--port N', Integer, 'Port for --serve (default: 8000)') { |v| options[:port] = v }
  opts.on('--completions [SHELL]', 'Print bash or zsh completions (default: detect $SHELL) and exit') do |v|
    shell = v || detect_shell
    source = File.join(install_root, 'completions', "certvis.#{shell}")
    unless File.exist?(source)
      warn "No completions available for '#{shell}' (supported: bash, zsh)"
      exit 1
    end
    puts File.read(source)
    exit
  end
  opts.on('-v', '--verbose', 'Print progress and a summary to stderr') { options[:verbose] = true }
  opts.on('-h', '--help', 'Show this help') do
    puts opts
    exit
  end
end.parse!

entries = Certvis::SiteList.load(options[:sites_file])
if entries.empty?
  warn "No sites found in #{options[:sites_file]}"
  exit 1
end

warn "Checking #{entries.size} site(s) with #{options[:threads]} thread(s)..." if options[:verbose]

checker = Certvis::Checker.new(timeout: options[:timeout], retries: options[:retries], backoff: options[:backoff])
runner = Certvis::Runner.new(checker: checker, threads: options[:threads])
results = runner.run(entries)

Certvis::JsonWriter.write(options[:output], results)

# --output can point anywhere (a webserver docroot, run from cron in any
# cwd), but public/index.html is a static file that isn't regenerated each
# run — bootstrap it next to the JSON so a bare -o deploys the whole page,
# and keep it in sync on later runs so bundled HTML/CSS/JS updates actually
# reach the deployed copy (--preserve-html opts out, e.g. for local edits).
if options[:deploy_html]
  source_html = File.join(install_root, 'public', 'index.html')
  target_html = File.join(File.dirname(File.expand_path(options[:output])), 'index.html')

  if File.expand_path(source_html) != target_html
    if !File.exist?(target_html)
      FileUtils.cp(source_html, target_html)
      warn "Deployed #{source_html} -> #{target_html}"
    elsif !options[:preserve_html] && !FileUtils.compare_file(source_html, target_html)
      FileUtils.cp(source_html, target_html)
      warn "Updated #{target_html} (was out of date)"
    end
  end
end

if options[:verbose]
  failed = results.count { |r| !r.reachable }
  warn "Done: #{results.size - failed}/#{results.size} reachable. Wrote #{options[:output]}"

  now = Time.now.utc
  problems = results.filter_map { |r| issues = site_issues(r, now); [r.name, issues] unless issues.empty? }
  unless problems.empty?
    warn 'Problems:'
    problems.sort_by { |name, _| name.downcase }.each do |name, issues|
      warn "  #{name}: #{issues.join(', ')}"
    end
  end
end

if options[:serve]
  begin
    require 'webrick'
  rescue LoadError
    warn "--serve needs the webrick gem: run `bundle install` or `gem install webrick`."
    exit 1
  end

  docroot = File.dirname(File.expand_path(options[:output]))
  server = WEBrick::HTTPServer.new(
    Port: options[:port],
    DocumentRoot: docroot,
    Logger: WEBrick::Log.new(File::NULL),
    AccessLog: []
  )
  trap('INT') { server.shutdown }
  warn "Serving #{docroot} at http://localhost:#{options[:port]}/ (Ctrl-C to stop)"
  server.start
end
